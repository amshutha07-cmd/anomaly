# Copy to .env in the repo root and fill in. Never commit the real file.

# Database (Supabase PostgreSQL connection string)
SUPABASE_DATABASE_URL=

# Supabase Auth (used by the API to validate access tokens)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# AI narratives
GROQ_API_KEY=
OPENROUTER_API_KEY=

# CORS: dashboard origins allowed to call the API (comma-separated)
DASHBOARD_ORIGINS=http://localhost:5173

# Alert delivery
ALERT_DELIVERY_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WORKER_TOKEN=
# Optional tuning
ALERT_MAX_ATTEMPTS=
ALERT_RETRY_BACKOFF_SECONDS=

# Scheduled cycle: base URL of the running API
HOSTED_API_BASE_URL=http://localhost:8000
